import React, { useState, useMemo } from 'react';
import { Printer, X, Calendar, ShoppingBag, Trophy, CheckSquare, Settings2, ArrowLeft, ArrowRight } from 'lucide-react';
import { AgendaEvent, FamilyMember, GroceryItem, TimeOfDay } from '../types/family';
import { soundEffects } from '../utils/audio';

interface PrintWeekModalProps {
  isOpen: boolean;
  events: AgendaEvent[];
  members: FamilyMember[];
  groceries: GroceryItem[];
  defaultDate?: string;
  initialScope?: 'week' | 'day';
  onNavigateToDay?: (dateStr: string) => void;
  onClose: () => void;
}

export const PrintWeekModal: React.FC<PrintWeekModalProps> = ({
  isOpen,
  events,
  members,
  groceries,
  defaultDate,
  initialScope = 'week',
  onNavigateToDay,
  onClose,
}) => {
  if (!isOpen) return null;

  // Huidige geselecteerde datum of vandaag
  const [selectedDate, setSelectedDate] = useState<string>(
    defaultDate || new Date().toISOString().split('T')[0]
  );
  
  // Modus: 'week' of 'day'
  const [printScope, setPrintScope] = useState<'week' | 'day'>(initialScope);

  // Instelbare opties wat er getoond moet worden op de print
  const [showGroceries, setShowGroceries] = useState(true);
  const [showRewardMeter, setShowRewardMeter] = useState(true);
  const [showNotes, setShowNotes] = useState(true);
  const [compactMode, setCompactMode] = useState(false);

  // Bereken de dagen van de week (maandag t/m zondag) op basis van selectedDate
  const weekDays = useMemo(() => {
    const curr = new Date(selectedDate);
    const day = curr.getDay();
    // Maandag als eerste dag van de week (als day === 0 (zondag), dan 6 dagen terug)
    const diffToMonday = curr.getDate() - day + (day === 0 ? -6 : 1);
    const monday = new Date(curr.setDate(diffToMonday));

    const days: { dateStr: string; dayName: string; dayNumber: number }[] = [];
    const dayNames = ['Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag', 'Zondag'];

    for (let i = 0; i < 7; i++) {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      const dateStr = d.toISOString().split('T')[0];
      days.push({
        dateStr,
        dayName: dayNames[i],
        dayNumber: d.getDate(),
      });
    }
    return days;
  }, [selectedDate]);

  // Hulpfunctie om dagen te verschuiven
  const handleShiftPeriod = (direction: 'prev' | 'next') => {
    soundEffects.playTap();
    const curr = new Date(selectedDate);
    if (printScope === 'week') {
      curr.setDate(curr.getDate() + (direction === 'next' ? 7 : -7));
    } else {
      curr.setDate(curr.getDate() + (direction === 'next' ? 1 : -1));
    }
    setSelectedDate(curr.toISOString().split('T')[0]);
  };

  const handlePrint = () => {
    soundEffects.playTap();
    window.print();
  };

  // Zoek Jaren (of het kind) voor de stermeter
  const childMember = members.find((m) => m.role === 'kind' || m.name.toLowerCase().includes('jaren')) || members[2];

  // Filter events voor de geselecteerde dag of week
  const filteredEvents = useMemo(() => {
    if (printScope === 'day') {
      return events.filter((e) => e.date === selectedDate);
    } else {
      const weekDateStrs = weekDays.map((d) => d.dateStr);
      return events.filter((e) => weekDateStrs.includes(e.date));
    }
  }, [events, printScope, selectedDate, weekDays]);

  const uncheckedGroceries = groceries.filter((g) => !g.checked);

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-2 sm:p-4 overflow-y-auto no-print">
      <div className="bg-white rounded-3xl shadow-2xl border-2 border-amber-300 w-full max-w-5xl max-h-[92vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        
        {/* Modal Header */}
        <div className="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-4 flex items-center justify-between text-white shrink-0">
          <div className="flex items-center gap-2.5">
            <div className="p-2 bg-white/20 rounded-xl">
              <Printer className="w-6 h-6" />
            </div>
            <div>
              <h2 className="text-xl font-black tracking-tight">Printerinstellingen & Afdrukken</h2>
              <p className="text-xs text-amber-100">Pas de opmaak aan en print direct op A4</p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-2 hover:bg-white/20 rounded-full transition-colors text-white"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Instellingen Paneel (Niet zichtbaar op print) */}
        <div className="bg-amber-50/70 p-4 border-b border-amber-200 flex flex-wrap items-center justify-between gap-4 shrink-0">
          
          {/* Weergave Modus & Datum Navigatie */}
          <div className="flex flex-wrap items-center gap-3">
            <div className="inline-flex bg-white p-1 rounded-xl border border-amber-300 shadow-2xs">
              <button
                type="button"
                onClick={() => { setPrintScope('week'); soundEffects.playTap(); }}
                className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
                  printScope === 'week' ? 'bg-amber-500 text-white shadow-xs' : 'text-slate-700 hover:bg-slate-100'
                }`}
              >
                📅 Hele Week
              </button>
              <button
                type="button"
                onClick={() => { setPrintScope('day'); soundEffects.playTap(); }}
                className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
                  printScope === 'day' ? 'bg-amber-500 text-white shadow-xs' : 'text-slate-700 hover:bg-slate-100'
                }`}
              >
                📆 Specifieke Dag
              </button>
            </div>

            <div className="flex items-center gap-1 bg-white px-2 py-1 rounded-xl border border-amber-300 shadow-2xs">
              <button
                type="button"
                onClick={() => handleShiftPeriod('prev')}
                className="p-1 hover:bg-amber-100 rounded-lg text-slate-700"
                title="Vorige"
              >
                <ArrowLeft className="w-4 h-4" />
              </button>
              <input
                type="date"
                value={selectedDate}
                onChange={(e) => setSelectedDate(e.target.value)}
                className="text-xs font-bold text-slate-800 bg-transparent border-none focus:outline-none px-1"
              />
              <button
                type="button"
                onClick={() => handleShiftPeriod('next')}
                className="p-1 hover:bg-amber-100 rounded-lg text-slate-700"
                title="Volgende"
              >
                <ArrowRight className="w-4 h-4" />
              </button>
            </div>
          </div>

          {/* Extra Inhoud Toggles */}
          <div className="flex flex-wrap items-center gap-3 text-xs font-semibold text-slate-700">
            <label className="flex items-center gap-1.5 cursor-pointer bg-white px-2.5 py-1.5 rounded-xl border border-amber-200">
              <input
                type="checkbox"
                checked={showGroceries}
                onChange={(e) => setShowGroceries(e.target.checked)}
                className="rounded text-amber-500 focus:ring-amber-400"
              />
              <span>Boodschappen</span>
            </label>

            <label className="flex items-center gap-1.5 cursor-pointer bg-white px-2.5 py-1.5 rounded-xl border border-amber-200">
              <input
                type="checkbox"
                checked={showRewardMeter}
                onChange={(e) => setShowRewardMeter(e.target.checked)}
                className="rounded text-amber-500 focus:ring-amber-400"
              />
              <span>⭐ Stermeter</span>
            </label>

            <label className="flex items-center gap-1.5 cursor-pointer bg-white px-2.5 py-1.5 rounded-xl border border-amber-200">
              <input
                type="checkbox"
                checked={compactMode}
                onChange={(e) => setCompactMode(e.target.checked)}
                className="rounded text-amber-500 focus:ring-amber-400"
              />
              <span>Compacte Weergave</span>
            </label>
          </div>
        </div>

        {/* Print Voorbeeld Container (Dit wordt daadwerkelijk afgedrukt via print-only stylesheet) */}
        <div className="p-6 overflow-y-auto flex-1 bg-slate-100 flex justify-center">
          
          <div className="print-only">
            {/* Hier komt de echte print-inhoud op A4 formaat */}
            <div className="print-sheet bg-white p-4 text-slate-900 border border-slate-300">
              
              {/* Print Header */}
              <div className="flex items-center justify-between border-b-2 border-amber-400 pb-2 mb-3">
                <div>
                  <h1 className="text-lg font-black text-slate-900">
                    🌟 FamiliePlanner — {printScope === 'week' ? 'Weekoverzicht Gezin' : `Dagoverzicht (${selectedDate})`}
                  </h1>
                  <p className="text-[10px] text-slate-600">Birger, Lieselot & Jaren 🎒⚽⭐</p>
                </div>
                {childMember && showRewardMeter && (
                  <div className="text-right text-xs font-bold bg-amber-100 px-3 py-1 rounded-lg border border-amber-300">
                    ⭐ {childMember.name.split(' ')[0]}: {childMember.stars || 0} / 5 sterren
                  </div>
                )}
              </div>

              {/* Inhoud: Weekoverzicht */}
              {printScope === 'week' ? (
                <div className="grid grid-cols-7 gap-1.5 flex-1">
                  {weekDays.map((day) => {
                    const dayEvs = events.filter((e) => e.date === day.dateStr);
                    return (
                      <div key={day.dateStr} className="border border-slate-300 rounded-lg p-1.5 flex flex-col bg-amber-50/20">
                        <div className="font-black text-center text-xs bg-amber-200 text-amber-900 rounded py-0.5 mb-1">
                          {day.dayName} {day.dayNumber}
                        </div>
                        <div className="space-y-1 overflow-hidden flex-1">
                          {dayEvs.length === 0 ? (
                            <p className="text-[9px] text-slate-400 text-center italic mt-2">Geen afspraken</p>
                          ) : (
                            dayEvs.map((ev) => {
                              const member = members.find((m) => m.id === ev.memberId);
                              return (
                                <div
                                  key={ev.id}
                                  className="text-[10px] p-1 rounded bg-white border border-slate-200 shadow-2xs"
                                >
                                  <div className="font-bold flex items-center justify-between">
                                    <span className="truncate">{ev.icon} {ev.title}</span>
                                    {member && (
                                      <span
                                        className="w-2 h-2 rounded-full shrink-0"
                                        style={{ backgroundColor: member.color || '#3b82f6' }}
                                      />
                                    )}
                                  </div>
                                  {ev.time && <div className="text-[8px] text-slate-500">⏰ {ev.time}</div>}
                                </div>
                              );
                            })
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              ) : (
                /* Inhoud: Specifieke Dag Uitgebreid */
                <div className="flex-1 space-y-3">
                  <div className="text-center bg-amber-100 py-2 rounded-xl font-black text-amber-900 text-sm border border-amber-300">
                    Agenda voor {new Date(selectedDate).toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
                  </div>
                  
                  <div className="grid grid-cols-3 gap-3">
                    {(['ochtend', 'middag', 'avond'] as TimeOfDay[]).map((tod) => {
                      const todEvs = filteredEvents.filter((e) => e.timeOfDay === tod || (!e.timeOfDay && tod === 'ochtend'));
                      const label = tod === 'ochtend' ? '🌅 Ochtend' : tod === 'middag' ? '☀️ Middag' : '🌙 Avond';
                      return (
                        <div key={tod} className="border border-slate-300 rounded-xl p-2.5 bg-slate-50">
                          <h3 className="font-bold text-xs text-slate-800 border-b border-slate-200 pb-1 mb-2">{label}</h3>
                          <div className="space-y-1.5">
                            {todEvs.length === 0 ? (
                              <p className="text-[10px] text-slate-400 italic">Geen gepland</p>
                            ) : (
                              todEvs.map((ev) => (
                                <div key={ev.id} className="p-1.5 bg-white rounded border border-slate-200 text-xs">
                                  <div className="font-bold">{ev.icon} {ev.title}</div>
                                  {ev.time && <div className="text-[10px] text-slate-500">⏰ {ev.time}</div>}
                                </div>
                              ))
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {/* Optionele Boodschappen / Notities strook onderaan */}
              {showGroceries && uncheckedGroceries.length > 0 && (
                <div className="mt-2 pt-2 border-t border-slate-300 flex items-center gap-2 text-[10px]">
                  <span className="font-bold bg-emerald-100 text-emerald-900 px-2 py-0.5 rounded">🛒 Belangrijkste Boodschappen:</span>
                  <div className="flex flex-wrap gap-1.5">
                    {uncheckedGroceries.slice(0, 8).map((item) => (
                      <span key={item.id} className="bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">
                        {item.icon} {item.name} ({item.quantity} {item.unit || ''})
                      </span>
                    ))}
                  </div>
                </div>
              )}

              {/* Footer */}
              <div className="mt-2 pt-1 border-t border-slate-200 flex items-center justify-between text-[9px] text-slate-500">
                <span>Geprinte gezinsagenda via FamiliePlanner</span>
                <span>Pagina 1 van 1</span>
              </div>
            </div>
          </div>

          {/* Scherm Voorbeeld (Interactief in de modal) */}
          <div className="bg-white border-2 border-dashed border-amber-300 rounded-2xl p-4 w-full max-w-4xl shadow-sm">
            <div className="text-xs font-bold text-slate-500 mb-2 flex items-center justify-between">
              <span>👁️ Voorbeeld van de afdruk ({printScope === 'week' ? 'Volledige Week' : 'Enkele Dag'})</span>
              {printScope === 'day' && onNavigateToDay && (
                <button
                  type="button"
                  onClick={() => onNavigateToDay(selectedDate)}
                  className="text-amber-700 hover:underline text-xs"
                >
                  Bekijk deze dag in Agenda &rarr;
                </button>
              )}
            </div>

            <div className="bg-amber-50/30 rounded-xl p-4 border border-amber-200 space-y-4">
              <div className="flex items-center justify-between border-b border-amber-200 pb-2">
                <div>
                  <h3 className="font-black text-slate-900 text-base">
                    {printScope === 'week' ? '📅 Weekoverzicht Gezin' : `📆 Dagoverzicht (${selectedDate})`}
                  </h3>
                  <p className="text-xs text-slate-600">Gezinsagenda voor Birger, Lieselot & Jaren</p>
                </div>
                <div className="text-xs font-bold bg-amber-200 text-amber-900 px-3 py-1 rounded-xl">
                  ⭐ {childMember?.name.split(' ')[0]}: {childMember?.stars || 0} sterren
                </div>
              </div>

              {/* Preview Grid */}
              {printScope === 'week' ? (
                <div className="grid grid-cols-1 sm:grid-cols-7 gap-2">
                  {weekDays.map((day) => {
                    const dayEvs = events.filter((e) => e.date === day.dateStr);
                    return (
                      <div key={day.dateStr} className="bg-white rounded-xl p-2 border border-amber-200 shadow-2xs">
                        <div className="font-black text-xs text-center bg-amber-100 text-amber-900 rounded-lg py-1 mb-2">
                          {day.dayName} {day.dayNumber}
                        </div>
                        <div className="space-y-1 min-h-[80px]">
                          {dayEvs.length === 0 ? (
                            <p className="text-[11px] text-slate-400 text-center italic mt-4">Geen afspraken</p>
                          ) : (
                            dayEvs.map((ev) => (
                              <div key={ev.id} className="text-xs p-1 rounded bg-amber-50/50 border border-amber-100">
                                <span className="font-bold">{ev.icon} {ev.title}</span>
                              </div>
                            ))
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              ) : (
                <div className="space-y-2">
                  <p className="text-sm font-bold text-slate-800">Geplande activiteiten ({filteredEvents.length}):</p>
                  <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    {filteredEvents.length === 0 ? (
                      <p className="text-xs text-slate-500 italic">Geen activiteiten gevonden op deze datum.</p>
                    ) : (
                      filteredEvents.map((ev) => (
                        <div key={ev.id} className="bg-white p-3 rounded-xl border border-amber-200 shadow-2xs">
                          <div className="font-bold text-sm">{ev.icon} {ev.title}</div>
                          {ev.time && <div className="text-xs text-slate-500">⏰ {ev.time}</div>}
                        </div>
                      ))
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>

        {/* Modal Footer met Print Knop */}
        <div className="bg-white px-6 py-4 border-t border-amber-200 flex items-center justify-between shrink-0">
          <button
            type="button"
            onClick={onClose}
            className="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-bold hover:bg-slate-50 transition-colors text-sm"
          >
            Sluiten
          </button>

          <button
            type="button"
            onClick={handlePrint}
            className="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-black shadow-md flex items-center gap-2 transition-all transform hover:scale-105"
          >
            <Printer className="w-5 h-5" />
            <span>Nu Afdrukken (A4)</span>
          </button>
        </div>

      </div>
    </div>
  );
};
